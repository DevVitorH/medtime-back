# Modelo do arquivo .env da API. Copie para ".env" (na pasta medtime-back) e preencha.
# O .env real NÃO vai para o Git; este modelo vai, sem valores secretos.
DB_USER=postgres
DB_PASSWORD=

# Assistente de IA: chave do Google Gemini (crie em aistudio.google.com, plano gratuito).
# Sem ela, o assistente avisa que não está configurado.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
